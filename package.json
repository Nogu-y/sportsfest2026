{
  "name": "sportsfest2026",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "concurrently -k -n web,infra \"pnpm --filter @sportsfest/web dev\" \"docker compose up api db\"",
    "dev:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check": "turbo run check"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
