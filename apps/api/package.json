{
  "name": "@sportsfest/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/index.ts src/server.ts --format esm --dts --out-dir dist",
    "lint": "echo 'lint not configured'",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "@hono/standard-validator": "^0.2.2",
    "@hono/swagger-ui": "^0.6.1",
    "@sportsfest/shared": "workspace:*",
    "@valibot/to-json-schema": "^1.6.0",
    "drizzle-orm": "^0.42.0",
    "hono": "^4.7.7",
    "hono-openapi": "^1.3.0",
    "postgres": "^3.4.5",
    "valibot": "^1.3.1"
  },
  "devDependencies": {
    "@sportsfest/config": "workspace:*",
    "@types/node": "^22.14.1",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
